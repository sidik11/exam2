{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://server1-osj0.onrender.com/api/:path*"
    },
    {
      "source": "/exam-api/:path*",
      "destination": "https://server1-osj0.onrender.com/exam-api/:path*"
    },
    {
      "source": "/student",
      "destination": "/frontend/CompetitiveExamMaster-student.html"
    },
    {
      "source": "/admin",
      "destination": "/frontend/CompetitiveExamMaster-admin.html"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/student",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/frontend/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    }
  ]
}
